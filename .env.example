# На сервере .env пишет Deploy workflow.
# Локально для compose задай готовый DATABASE_URL (как в backend/.env):
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DB

DEBUG=false
BACKEND_PORT=8000
FRONTEND_PORT=8080
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# openrouteservice: docker compose --profile ors up -d ors (см. solution/deploy/ors/README.md).
# Пусто — backend считает на кэше маршрутов, без кэша — по координатам.
ORS_URL=http://ors:8082/ors
ORS_XMS=4g
ORS_XMX=10g
# Экономный режим (стенд с 3-4 ГБ RAM): MMAP, false, 2g и XMS/XMX 512m/1g
ORS_GRAPHS_DATA_ACCESS=RAM_STORE
ORS_TRANSIT=true
ORS_MEM_LIMIT=16g

# Геокодирование новых адресов при загрузке заявок. Ключ — dadata.ru (API-ключ);
# секретный ключ включает стандартизацию (платная) вместо подсказок.
# Без ключа — только кэш solution/data/geocache.json и Photon/Nominatim.
DADATA_API_KEY=
DADATA_SECRET_KEY=
GEOCODER_OSM_ENABLED=true
