# На стенде файл создаётся вручную (DEPLOY.md п. 3) или пишется Deploy workflow.
# Не коммитить. Рекомендуется: chmod 600 .env
#
# DATABASE_URL обязателен. Пароль в URL: URL-encode (@ -> %40, : -> %3A и т.д.).
# Значения со спецсимволами заключать в одинарные кавычки.

DATABASE_URL='postgresql+asyncpg://postgres:postgres@db:5432/lct'
POSTGRES_USER='postgres'
POSTGRES_PASSWORD='postgres'
POSTGRES_DB='lct'
POSTGRES_HOST='db'
POSTGRES_PORT='5432'

DEBUG='false'
BACKEND_PORT='8000'
FRONTEND_PORT='8080'
CORS_ORIGINS='["http://localhost:5173","http://localhost:8080"]'

# openrouteservice: docker compose --profile ors up -d ors
# Пустой ORS_URL: backend считает на кэше маршрутов, без кэша по координатам.
ORS_URL='http://ors:8082/ors'
ORS_API_KEY=''
ORS_FALLBACK_URL=''
# Локальная сборка графов (>=12 ГБ RAM):
ORS_XMS='4g'
ORS_XMX='10g'
ORS_GRAPHS_DATA_ACCESS='RAM_STORE'
ORS_TRANSIT='true'
ORS_MEM_LIMIT='16g'
# Стенд 4 ГБ (графы залиты upload-graphs.sh):
# ORS_XMS='512m'
# ORS_XMX='1g'
# ORS_GRAPHS_DATA_ACCESS='MMAP'
# ORS_TRANSIT='false'
# ORS_MEM_LIMIT='2g'

# Геокодирование: ключ dadata.ru; секрет включает стандартизацию (платно).
# Без ключей: кэш solution/data/geocache.json и Photon/Nominatim.
DADATA_API_KEY=''
DADATA_SECRET_KEY=''
GEOCODER_OSM_ENABLED='true'
