# На сервере .env пишет Deploy workflow.
# Локально для compose задай готовый DATABASE_URL (как в backend/.env):
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DB

DEBUG=false
BACKEND_PORT=8000
FRONTEND_PORT=8080
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# openrouteservice: docker compose --profile ors up -d ors (см. solution/deploy/ors/README.md).
# Пусто — backend считает на кэше маршрутов, без кэша — по координатам.
ORS_URL=http://ors:8082/ors
ORS_XMS=4g
ORS_XMX=10g
