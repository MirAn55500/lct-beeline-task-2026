# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lct
POSTGRES_PORT=5432

# Backend (DATABASE_URL собирается в docker-compose с хостом db)
DEBUG=false
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:5173"]

# Frontend (контейнерный nginx на 8080; с хоста проксируй на него)
FRONTEND_PORT=8080
