# Postgres — DATABASE_URL собирается в docker-compose из этих полей
POSTGRES_USER=beeline-lct
POSTGRES_PASSWORD=
POSTGRES_DB=beeline-lct
POSTGRES_HOST=
POSTGRES_PORT=5432

# Backend
DEBUG=false
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# Frontend (контейнерный nginx на 8080; хостовый nginx → :8080)
FRONTEND_PORT=8080
