# Database
# Для remote БД задай DATABASE_URL — локальный сервис db тогда не нужен
# (профиль local-db: docker compose --profile local-db up -d)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/lct
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lct
POSTGRES_PORT=5432

# Backend
DEBUG=false
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# Frontend (контейнерный nginx на 8080; с хоста проксируй на него)
# /api внутри контейнера идёт на сервис backend:8000
FRONTEND_PORT=8080
