# Database — обязателен для compose (remote Postgres)
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lct
POSTGRES_PORT=5432

# Backend
DEBUG=false
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# Frontend (контейнерный nginx на 8080; хостовый nginx → :8080)
# /api внутри сети lct-net идёт на backend:8000
FRONTEND_PORT=8080
