# Токен, который стенд передаёт в заголовке Authorization (GitHub secret ORS_API_KEY).
# Сгенерировать: openssl rand -hex 32
ORS_TOKEN=

# Порт nginx наружу. Открыть в файрволе только для IP стенда
ORS_PORT=8081

# Память Java: графы ЦФО с общественным транспортом занимают ~7.5 ГБ
ORS_XMS=4g
ORS_XMX=10g
